 *
 * CachyOS Calamares dark theme stylesheet.
 * Dark background with cyan (#00CED1) accents throughout.
 */

/* --- Base dark theme --- */

QWidget {
    font: 13px;
    background-color: #1E2328;
    color: #E0E0E0;
}

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

/* Main content area */
#mainApp {
    background-color: #1E2328;
}

QLabel {
    background-color: transparent;
}

/* --- Buttons --- */

QPushButton {
    padding: 6px 16px;
    border-radius: 4px;
    border: 1px solid #00CED1;
    background-color: transparent;
    color: #E0E0E0;
    min-height: 28px;
}

QPushButton:hover {
    background-color: rgba(0, 206, 209, 0.15);
}

QPushButton:pressed {
    background-color: rgba(0, 206, 209, 0.25);
}

QPushButton:disabled {
    border-color: #3A4248;
    color: #666666;
}

QPushButton:default {
    background-color: #00CED1;
    color: #1E2328;
    border: none;
    font-weight: bold;
}

QPushButton:default:hover {
    background-color: #00E5E8;
}

QPushButton:default:pressed {
    background-color: #00B5B8;
}

/* --- Debug button --- */

#debugButton {
    background-color: none;
    font: bold 8px;
    color: #ffffff;
    height: 32px;
    padding: 0px;
    border: none;
}

/* --- Welcome module --- */

#aboutButton {
    background-color: none;
    font: 14px;
    border: none;
}

/* --- Combo boxes --- */

QComboBox {
    padding: 4px 8px;
    border: 1px solid #3A4248;
    border-radius: 4px;
    background-color: #2D3339;
    color: #E0E0E0;
    min-height: 26px;
}

QComboBox:hover {
    border-color: #00CED1;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #2D3339;
    color: #E0E0E0;
    border: 1px solid #3A4248;
    selection-background-color: rgba(0, 206, 209, 0.25);
    selection-color: #FFFFFF;
}

/* --- List/Tree views (packagechooser, netinstall) --- */

QListView, QTreeView {
    background-color: #2D3339;
    alternate-background-color: #262C31;
    border: 1px solid #3A4248;
    border-radius: 4px;
    color: #E0E0E0;
}

QListView::item, QTreeView::item {
    padding: 4px;
    min-height: 24px;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: rgba(0, 206, 209, 0.2);
    color: #FFFFFF;
}

QListView::item:hover, QTreeView::item:hover {
    background-color: rgba(0, 206, 209, 0.1);
}

QHeaderView {
    background-color: #292F34;
    color: #E0E0E0;
}

QHeaderView::section {
    background-color: #292F34;
    color: #E0E0E0;
    border: none;
    border-right: 1px solid #3A4248;
    border-bottom: 1px solid #3A4248;
    padding: 4px 8px;
    font-weight: bold;
}

/* --- Group boxes --- */

QGroupBox {
    border: 1px solid #3A4248;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
    font-weight: bold;
    color: #E0E0E0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #00CED1;
}

/* --- Line edits --- */

QLineEdit {
    padding: 4px 8px;
    border: 1px solid #3A4248;
    border-radius: 4px;
    background-color: #2D3339;
    color: #E0E0E0;
    min-height: 26px;
}

QLineEdit:focus {
    border-color: #00CED1;
}

/* --- Spin boxes --- */

QSpinBox, QDoubleSpinBox {
    padding: 4px 8px;
    border: 1px solid #3A4248;
    border-radius: 4px;
    background-color: #2D3339;
    color: #E0E0E0;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #00CED1;
}

/* --- Scroll bars --- */

QScrollBar:vertical {
    width: 8px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    background: #555555;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #777777;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* --- Progress bar (partition) --- */

QProgressBar {
    border: 1px solid #3A4248;
    border-radius: 4px;
    background-color: #2D3339;
    color: #E0E0E0;
    text-align: center;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: #00CED1;
    border-radius: 3px;
}

/* --- Tab widget (partition) --- */

QTabWidget::pane {
    border: 1px solid #3A4248;
    background-color: #1E2328;
}

QTabBar::tab {
    padding: 6px 16px;
    background-color: #292F34;
    border: 1px solid #3A4248;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #E0E0E0;
}

QTabBar::tab:selected {
    background-color: #1E2328;
    border-bottom-color: #1E2328;
    color: #00CED1;
}

QTabBar::tab:hover:!selected {
    background-color: #2D3339;
}

/* --- Radio buttons and checkboxes --- */

QRadioButton, QCheckBox {
    spacing: 6px;
    background-color: transparent;
    color: #E0E0E0;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

/* --- Frames --- */

QFrame {
    background-color: transparent;
}

/* --- Tooltips --- */

QToolTip {
    background-color: #292F34;
    color: #FFFFFF;
    border: 1px solid #3A4248;
    border-radius: 4px;
    padding: 4px 8px;
}

/* --- Splitter handle --- */

QSplitter::handle {
    background-color: #3A4248;
    width: 1px;
}

/* --- Menus --- */

QMenu {
    background-color: #2D3339;
    color: #E0E0E0;
    border: 1px solid #3A4248;
}

QMenu::item:selected {
    background-color: rgba(0, 206, 209, 0.2);
    color: #FFFFFF;
}

/* --- Scroll area --- */

QScrollArea {
    background-color: transparent;
    border: none;
}

/* --- Text browser/edit (used in some modules) --- */

QTextBrowser, QTextEdit, QPlainTextEdit {
    background-color: #2D3339;
    color: #E0E0E0;
    border: 1px solid #3A4248;
    border-radius: 4px;
}

/* --- Slider --- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #3A4248;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #00CED1;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background-color: #00CED1;
    border-radius: 2px;
}
