 * SPDX-License-Identifier: CC0-1.0
 *
 * CachyOS Calamares stylesheet.
 * Styles remaining widget-based modules (partition, packagechooser, netinstall)
 * to look consistent alongside QML modules.
 */

/* --- Base --- */

QWidget {
    font: 13px;
}

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

/* --- Buttons --- */

QPushButton {
    padding: 6px 16px;
    border-radius: 4px;
    border: 1px solid #00CED1;
    background-color: transparent;
    min-height: 28px;
}

QPushButton:hover {
    background-color: rgba(0, 206, 209, 0.12);
}

QPushButton:pressed {
    background-color: rgba(0, 206, 209, 0.25);
}

QPushButton:disabled {
    border-color: #555555;
    color: #888888;
}

/* Primary action buttons in Calamares dialogs */
QPushButton:default {
    background-color: #00CED1;
    color: #292F34;
    border: none;
    font-weight: bold;
}

QPushButton:default:hover {
    background-color: #00E5E8;
}

QPushButton:default:pressed {
    background-color: #00B5B8;
}

/* --- Debug button --- */

#debugButton {
    background-color: none;
    font: bold 8px;
    color: #ffffff;
    height: 32px;
    padding: 0px;
    border: none;
}

/* --- Welcome module --- */

#aboutButton {
    background-color: none;
    font: 14px;
    border: none;
}

/* --- Combo boxes --- */

QComboBox {
    padding: 4px 8px;
    border: 1px solid #888888;
    border-radius: 4px;
    min-height: 26px;
}

QComboBox:hover {
    border-color: #00CED1;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* --- List/Tree views (packagechooser, netinstall) --- */

QListView, QTreeView {
    border: 1px solid #888888;
    border-radius: 4px;
    alternate-background-color: rgba(0, 0, 0, 0.03);
}

QListView::item, QTreeView::item {
    padding: 4px;
    min-height: 24px;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: rgba(0, 206, 209, 0.15);
    color: palette(text);
}

QListView::item:hover, QTreeView::item:hover {
    background-color: rgba(0, 206, 209, 0.08);
}

/* --- Group boxes --- */

QGroupBox {
    border: 1px solid #cccccc;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
}

/* --- Line edits --- */

QLineEdit {
    padding: 4px 8px;
    border: 1px solid #888888;
    border-radius: 4px;
    min-height: 26px;
}

QLineEdit:focus {
    border-color: #00CED1;
}

/* --- Scroll bars --- */

QScrollBar:vertical {
    width: 8px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #888888;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #aaaaaa;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    background: #888888;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #aaaaaa;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Progress bar (partition) --- */

QProgressBar {
    border: 1px solid #888888;
    border-radius: 4px;
    text-align: center;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: #00CED1;
    border-radius: 3px;
}

/* --- Tab widget (partition) --- */

QTabBar::tab {
    padding: 6px 16px;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    border-color: #888888;
    border-bottom-color: palette(window);
}

QTabBar::tab:hover:!selected {
    background-color: rgba(0, 206, 209, 0.08);
}

/* --- Radio buttons and checkboxes --- */

QRadioButton, QCheckBox {
    spacing: 6px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

/* --- Tooltips --- */

QToolTip {
    background-color: #292F34;
    color: #FFFFFF;
    border: 1px solid #3A4248;
    border-radius: 4px;
    padding: 4px 8px;
}

/* --- Splitter handle (packagechooser) --- */

QSplitter::handle {
    background-color: #cccccc;
    width: 1px;
}
